    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch via NPM",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "debug"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },        
        {
            "command": "pnpm vavite-loader vite dev --port 3000",
            "name": "Launch SvelteKit server",
            "request": "launch",
            "type": "node-terminal"
        }
    ]
}